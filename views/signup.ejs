<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>sign-up</title>
    <link rel="stylesheet" href="/output.css">
</head>
<body>
    <div class="antialiased selection:bg-purple-500 selection:text-white">
  <div class="bg-white dark:bg-slate-950 transition-colors duration-300">
    <div class="bg-gradient-to-r from-purple-900 via-purple-800 to-purple-600 dark:from-gray-900 dark:via-slate-900 dark:to-purple-950">
      <div class="min-h-screen flex flex-col items-center justify-center p-6">
        <div class="grid md:grid-cols-2 items-center gap-10 max-w-6xl w-full">
          
          <div class="max-w-lg max-md:mx-auto max-md:text-center">
            <a>
              <!-- URL Shortener SVG Logo -->
              <svg width="400" height="190" viewBox="0 0 680 320" fill="none" xmlns="http://www.w3.org/2000/svg" class="mb-12 inline-block">
                <defs>
                  <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                    <path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </marker>
                  <style>
                    .wm   { font-family:'Syne','Inter',sans-serif; font-weight:800; font-size:64px; }
                    .sub  { font-family:'DM Sans','Inter',sans-serif; font-weight:400; font-size:11px; letter-spacing:4px; }
                    .mono { font-family:'DM Mono','Courier New',monospace; font-size:11px; }
                    .feat { font-family:'DM Sans','Inter',sans-serif; font-size:12px; }
                  </style>
                </defs>

                <!-- Scissors icon -->
                <line x1="58" y1="60" x2="108" y2="120" stroke="white" stroke-width="7" stroke-linecap="round"/>
                <line x1="108" y1="60" x2="58" y2="120" stroke="#3B82F6" stroke-width="7" stroke-linecap="round"/>
                <circle cx="83" cy="90" r="5.5" fill="white"/>
                <circle cx="46" cy="132" r="13" fill="none" stroke="white" stroke-width="5"/>
                <circle cx="120" cy="132" r="13" fill="none" stroke="#3B82F6" stroke-width="5"/>

                <!-- Wordmark -->
                <text class="wm" x="148" y="118" fill="white">URL <tspan fill="#3B82F6">Short</tspan>ener</text>

                <!-- Tagline -->
                <text class="sub" x="150" y="146" fill="#C4B5FD">SHORTEN · SHARE · TRACK</text>

                <!-- Divider -->
                <line x1="150" y1="164" x2="620" y2="164" stroke="rgba(255,255,255,0.2)" stroke-width="0.5"/>

                <!-- Pills -->
                <rect x="150" y="178" width="72" height="24" rx="12" fill="rgba(255,255,255,0.12)" stroke="rgba(255,255,255,0.3)" stroke-width="0.6"/>
                <text class="feat" x="186" y="194" fill="white" text-anchor="middle">Fast</text>

                <rect x="234" y="178" width="98" height="24" rx="12" fill="rgba(59,130,246,0.2)" stroke="#3B82F6" stroke-width="0.6"/>
                <text class="feat" x="283" y="194" fill="#93C5FD" text-anchor="middle">Trackable</text>

                <rect x="344" y="178" width="82" height="24" rx="12" fill="rgba(255,255,255,0.12)" stroke="rgba(255,255,255,0.3)" stroke-width="0.6"/>
                <text class="feat" x="385" y="194" fill="white" text-anchor="middle">Secure</text>

                <!-- URL transformation -->
                <rect x="150" y="224" width="340" height="32" rx="8" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.2)" stroke-width="0.5"/>
                <text class="mono" x="164" y="245" fill="rgba(255,255,255,0.5)">https://example.com/long/path?ref=home</text>

                <line x1="496" y1="240" x2="520" y2="240" stroke="white" stroke-width="1.5" marker-end="url(#arrow)"/>

                <rect x="526" y="224" width="100" height="32" rx="8" fill="rgba(59,130,246,0.25)" stroke="#3B82F6" stroke-width="0.8"/>
                <text class="mono" x="576" y="245" fill="#93C5FD" text-anchor="middle" font-weight="700">go.to/x4k</text>

                <!-- Bottom tagline -->
                <text class="feat" x="340" y="294" fill="rgba(255,255,255,0.4)" text-anchor="middle">paste long · get short · share anywhere</text>
              </svg>
            </a>

            <p class="text-[15px] mt-6 text-purple-100 dark:text-gray-300 leading-relaxed">
              Shorten, share, and track your links with a secure, verifiable system that makes every URL count.
            </p>
           
          </div>

          <form class="bg-white dark:bg-slate-900 dark:border dark:border-slate-800 rounded-xl px-8 py-12 max-w-md md:ml-auto max-md:mx-auto w-full shadow-2xl transition-all" method="post" action="/signup">
            <h2 class="text-slate-900 dark:text-white text-3xl font-bold mb-12">
              Sign up
            </h2>
            
            <div class="space-y-4">
                <div>
                <input name="name" required 
                  class="bg-gray-100 dark:bg-slate-800 border border-transparent dark:border-slate-700 focus:bg-transparent focus:border-purple-500 w-full text-sm text-slate-900 dark:text-white px-4 py-3 rounded-md outline-none transition-all placeholder-gray-500" 
                  placeholder="Name" />
              </div>
              <div>
                <input name="email" type="email" autocomplete="email" required 
                  class="bg-gray-100 dark:bg-slate-800 border border-transparent dark:border-slate-700 focus:bg-transparent focus:border-purple-500 w-full text-sm text-slate-900 dark:text-white px-4 py-3 rounded-md outline-none transition-all placeholder-gray-500" 
                  placeholder="Email address" />
              </div>
              <div>
                <input name="password" type="password" autocomplete="current-password" required 
                  class="bg-gray-100 dark:bg-slate-800 border border-transparent dark:border-slate-700 focus:bg-transparent focus:border-purple-500 w-full text-sm text-slate-900 dark:text-white px-4 py-3 rounded-md outline-none transition-all placeholder-gray-500" 
                  placeholder="Password" />
              </div>
              <div class="text-sm text-right">
                <a href="javascript:void(0);" class="text-blue-600 dark:text-purple-400 font-medium hover:underline">
                  Forgot your password?
                </a>

              </div>
              <% if(locals.error) {%>
                <div>
                    <p class="text-white">The email-id is already exists</p>
                </div>
                <% } %>
            </div>

            <div class="mt-12">
              <button type="submit" 
                class="w-full shadow-xl py-3 px-6 text-[15px] font-semibold rounded-md text-white bg-slate-800 hover:bg-slate-900 dark:bg-purple-600 dark:hover:bg-purple-700 transition-all active:scale-[0.98] cursor-pointer">
                Sign Up
              </button>
            </div>

            <p class="my-6 text-sm text-slate-500 dark:text-slate-400 text-center">or continue with</p>

            <div class="space-x-6 flex justify-center">
              <button type="button" class="group p-2 rounded-lg border border-gray-200 dark:border-slate-700 hover:bg-gray-50 dark:hover:bg-slate-800 transition-colors cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 inline" viewBox="0 0 512 512">
                  <path fill="#fbbd00" d="M120 256c0-25.367 6.989-49.13 19.131-69.477v-86.308H52.823C18.568 144.703 0 198.922 0 256s18.568 111.297 52.823 155.785h86.308v-86.308C126.989 305.13 120 281.367 120 256z" />
                  <path fill="#0f9d58" d="m256 392-60 60 60 60c57.079 0 111.297-18.568 155.785-52.823v-86.216h-86.216C305.044 385.147 281.181 392 256 392z" />
                  <path fill="#31aa52" d="m139.131 325.477-86.308 86.308a260.085 260.085 0 0 0 22.158 25.235C123.333 485.371 187.62 512 256 512V392c-49.624 0-93.117-26.72-116.869-66.523z" />
                  <path fill="#3c79e6" d="M512 256a258.24 258.24 0 0 0-4.192-46.377l-2.251-12.299H256v120h121.452a135.385 135.385 0 0 1-51.884 55.638l86.216 86.216a260.085 260.085 0 0 0 25.235-22.158C485.371 388.667 512 324.38 512 256z" />
                  <path fill="#cf2d48" d="m352.167 159.833 10.606 10.606 84.853-84.852-10.606-10.606C388.668 26.629 324.381 0 256 0l-60 60 60 60c36.326 0 70.479 14.146 96.167 39.833z" />
                  <path fill="#eb4132" d="M256 120V0C187.62 0 123.333 26.629 74.98 74.98a259.849 259.849 0 0 0-22.158 25.235l86.308 86.308C162.883 146.72 206.376 120 256 120z" />
                </svg>
              </button>
              
              <button type="button" class="group p-2 rounded-lg border border-gray-200 dark:border-slate-700 hover:bg-gray-50 dark:hover:bg-slate-800 transition-colors cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 fill-black dark:fill-white" viewBox="0 0 22.773 22.773">
                  <path d="M15.769 0h.162c.13 1.606-.483 2.806-1.228 3.675-.731.863-1.732 1.7-3.351 1.573-.108-1.583.506-2.694 1.25-3.561C13.292.879 14.557.16 15.769 0zm4.901 16.716v.045c-.455 1.378-1.104 2.559-1.896 3.655-.723.995-1.609 2.334-3.191 2.334-1.367 0-2.275-.879-3.676-.903-1.482-.024-2.297.735-3.652.926h-.462c-.995-.144-1.798-.932-2.383-1.642-1.725-2.098-3.058-4.808-3.306-8.276v-1.019c.105-2.482 1.311-4.5 2.914-5.478.846-.52 2.009-.963 3.304-.765.555.086 1.122.276 1.619.464.471.181 1.06.502 1.618.485.378-.011.754-.208 1.135-.347 1.116-.403 2.21-.865 3.652-.648 1.733.262 2.963 1.032 3.723 2.22-1.466.933-2.625 2.339-2.427 4.74.176 2.181 1.444 3.457 3.028 4.209z"></path>
                </svg>
              </button>
              
              <button type="button" class="group p-2 rounded-lg border border-gray-200 dark:border-slate-700 hover:bg-gray-50 dark:hover:bg-slate-800 transition-colors cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 fill-[#007bff] dark:fill-[#1877F2]" viewBox="0 0 167.657 167.657">
                  <path d="M83.829.349C37.532.349 0 37.881 0 84.178c0 41.523 30.222 75.911 69.848 82.57v-65.081H49.626v-23.42h20.222V60.978c0-20.037 12.238-30.956 30.115-30.956 8.562 0 15.92.638 18.056.919v20.944l-12.399.006c-9.72 0-11.594 4.618-11.594 11.397v14.947h23.193l-3.025 23.42H94.026v65.653c41.476-5.048 73.631-40.312 73.631-83.154 0-46.273-37.532-83.805-83.828-83.805z"></path>
                </svg>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
</body>
</html>